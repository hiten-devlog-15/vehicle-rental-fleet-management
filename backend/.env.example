# Environment Variables — DriveFleet Backend
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to GitHub.

# MongoDB connection string from MongoDB Atlas or local MongoDB
MONGO_URI=your_mongodb_connection_string_here

# Port for the Express server (default: 5000)
PORT=5000

# Allowed frontend origin for CORS (Experiment 5)
# Set this to the URL where your React frontend runs
FRONTEND_URL=http://localhost:5173

# Node environment: "development" or "production"
NODE_ENV=development
