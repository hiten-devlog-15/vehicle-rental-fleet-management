# Environment Variables — DriveFleet Backend
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to GitHub.

# MongoDB connection string from MongoDB Atlas or local MongoDB
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.7y52ahq.mongodb.net/drivefleet?appName=Cluster0
DB_NAME=drivefleet

# Port for the Express server (default: 5000)
PORT=5000

# Allowed frontend origin for CORS (Experiment 5)
# Set this to the URL where your React frontend runs
FRONTEND_URL=http://localhost:5173

# Node environment: "development" or "production"
NODE_ENV=development

# ── Experiment 6: JWT Authentication ─────────────────────────────────────────
# JWT secret key — use a long, random, unique string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER expose this value publicly. NEVER commit .env to Git.
JWT_SECRET=replace_with_a_long_random_secret_key_minimum_32_characters

# How long JWTs remain valid (e.g., 7d, 24h, 30m)
JWT_EXPIRES_IN=7d

# ── Experiment 9 & Production: Email Notifications (Nodemailer + SMTP / Gmail) ─
# Standard SMTP configuration (Gmail, SendGrid, Mailgun, Brevo, AWS SES, or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="DriveFleet Notifications <your-email@gmail.com>"

# Backwards-compatible aliases for Gmail SMTP:
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Public Client URL used in email buttons and links
CLIENT_URL=http://localhost:5173
