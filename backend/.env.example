# Environment Variables — DriveFleet Backend
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to GitHub.

# MongoDB connection string from MongoDB Atlas or local MongoDB
MONGO_URI=your_mongodb_connection_string_here

# Port for the Express server (default: 5000)
PORT=5000

# Allowed frontend origin for CORS (Experiment 5)
# Set this to the URL where your React frontend runs
FRONTEND_URL=http://localhost:5173

# Node environment: "development" or "production"
NODE_ENV=development

# ── Experiment 6: JWT Authentication ─────────────────────────────────────────
# JWT secret key — use a long, random, unique string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER expose this value publicly. NEVER commit .env to Git.
JWT_SECRET=replace_with_a_long_random_secret_key_minimum_32_characters

# How long JWTs remain valid (e.g., 7d, 24h, 30m)
JWT_EXPIRES_IN=7d
